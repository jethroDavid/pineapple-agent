{
  "name": "@pineapple/shared-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./json": {
      "types": "./src/json.ts",
      "import": "./dist/json.js"
    },
    "./trigger-event": {
      "types": "./src/trigger-event.ts",
      "import": "./dist/trigger-event.js"
    },
    "./trigger-prompt": {
      "types": "./src/trigger-prompt.ts",
      "import": "./dist/trigger-prompt.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node -e \"console.log('No tests in @pineapple/shared-contracts')\""
  },
  "dependencies": {
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
