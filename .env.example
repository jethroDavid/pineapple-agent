NODE_ENV=development
LOG_LEVEL=debug
TRACE_CONSOLE=true
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pineapple
OPENAI_API_KEY=
OPENAI_MODEL=
CRON_ENABLED=true
# Example jobs:
# - recurring every 30 seconds
# - one-time run (max_runs=1)
CRON_JOBS_JSON=[{"id":"heartbeat","expression":"*/30 * * * * *","message":"Heartbeat check","allow_unbound_thread":true},{"id":"once-at-start","expression":"0 */10 * * * *","message":"One-time reminder","allow_unbound_thread":true,"max_runs":1}]
SHORTCUT_API_TOKEN=
SHORTCUT_WEBHOOK_SECRET=
SHORTCUT_WEBHOOK_BASE_URL=
SHORTCUT_WEBHOOK_INTEGRATION_ID=
SHORTCUT_AGENT_NAME=pineapple
TELEGRAM_BOT_TOKEN=
TELEGRAM_INBOUND_MODE=
TELEGRAM_ALLOWED_UPDATES=message,edited_message
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_MAX_CONNECTIONS=10
TELEGRAM_POLL_INTERVAL_MS=1000
TELEGRAM_POLL_TIMEOUT_SECONDS=1
