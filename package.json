{
  "name": "pineapple-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @pineapple/backend dev",
    "web:dev": "pnpm --filter @pineapple/web dev",
    "web:build": "pnpm --filter @pineapple/web build",
    "mobile:start": "pnpm --filter mobile start",
    "mobile:android": "pnpm --filter mobile android",
    "mobile:ios": "pnpm --filter mobile ios",
    "build": "turbo run build",
    "start": "pnpm --filter @pineapple/backend start",
    "pineapple": "pnpm --filter @pineapple/backend dev:easy",
    "check": "turbo run check",
    "test": "turbo run test",
    "test:watch": "pnpm --filter @pineapple/backend test:watch",
    "db:up": "pnpm --filter @pineapple/backend db:up",
    "db:down": "pnpm --filter @pineapple/backend db:down",
    "db:status": "pnpm --filter @pineapple/backend db:status",
    "db:generate": "pnpm --filter @pineapple/backend db:generate",
    "db:migrate": "pnpm --filter @pineapple/backend db:migrate",
    "db:studio": "pnpm --filter @pineapple/backend db:studio",
    "dev:easy": "pnpm --filter @pineapple/backend dev:easy"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}
